# ==============================================================================
# MUNNA AI — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Configure these in your Vercel Project Settings -> Environment Variables.
# NEVER commit real secret values to Git or share them publicly.

# 1. Google Gemini Multimodal AI (Required for Chat & Vision)
GEMINI_API_KEY=your_google_gemini_api_key

# 2. Supabase Cloud (Required for Real Authentication & Sessions)
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# 3. Pixazo AI Image Gateway (Optional - falls back to FLUX.1 if omitted)
PIXAZO_API_KEY=your_pixazo_api_key

# 4. Cartesia Sonic Realtime Voice AI (Primary low-latency TTS)
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_VOICE_ID=bdab08ad-4137-4548-b9db-6142854c7525

# 5. ElevenLabs Studio Voice AI (Fallback TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVEN_VOICE_ID=pNInz6obpgDQGcFmaJgB
